# ====================== 기본 무시 ======================
# OS / IDE / Python 관련
.DS_Store
Thumbs.db
config.py
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# 환경설정 파일 (민감 정보 보호)
.env
*.env

# 데이터 파일 (로컬/원격 충돌 방지를 위해 기본 추적 제외)
